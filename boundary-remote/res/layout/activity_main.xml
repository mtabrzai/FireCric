<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/panel_connect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BOUNDARY"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="STEP 1 OF 2 / CONNECT"
            android:textColor="@color/sub"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Connect your bat."
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open this app on your phone while the TV shows the pairing screen. Same Wi-Fi network."
            android:textColor="@color/sub"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/ip_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Fire TV IP address"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/sub" />

        <Button
            android:id="@+id/btn_find"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_lime"
            android:text="Find TV"
            android:textColor="#FF060F0E"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_dark"
            android:text="Connect"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/connect_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Waiting for your phone… enter the TV code or tap Find TV"
            android:textColor="@color/sub"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_calibrate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BOUNDARY"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="STEP 2 OF 2 / CALIBRATION"
            android:textColor="@color/sub"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Set your stance."
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Hold your phone as you would a bat. Keep it still for three seconds."
            android:textColor="@color/sub"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/calib_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:max="3"
            android:progress="0"
            android:progressTint="@color/accent" />

        <TextView
            android:id="@+id/calib_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="HOLD STILL\n3 seconds remaining"
            android:textColor="@color/accent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Motion access: Enabled\nKeep a clear space around you. A secure grip or wrist strap is recommended."
            android:textColor="@color/sub"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_play"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BOUNDARY"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/play_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="CONNECTED"
            android:textColor="@color/sub"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Your bat is ready."
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/play_score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="YOU: 0 / 0"
            android:textColor="@color/accent"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/play_hint"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Move phone = place bat · SWING = strike"
            android:textColor="@color/sub"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_swing"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:background="@drawable/btn_lime"
            android:text="SWING"
            android:textColor="#FF060F0E"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_dark"
                android:text="Start innings"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/btn_pause"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_dark"
                android:text="Pause game"
                android:textColor="@color/text" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_dark"
            android:text="Back to lobby"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Clear your space. Use a secure grip or strap."
            android:textColor="@color/sub"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
